# ─────────────────────────────────────────────────────────────────────────────
# MCP Web Client – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── OAuth 2.1 Provider ────────────────────────────────────────────────────────
# Obtain from your OAuth provider's developer console.
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# Authorization endpoint (the URL the browser is redirected to for login)
OAUTH_AUTH_URL=https://auth.example.com/authorize

# Token endpoint (called server-side to exchange the code for tokens)
OAUTH_TOKEN_URL=https://auth.example.com/token

# Scope requested from the authorization server.
# "openid profile" gives you an id_token with user info.
# Add your MCP audience/scope here, e.g. "openid profile mcp:read"
OAUTH_SCOPE=openid profile

# The URI the OAuth provider will redirect back to after login.
# Must match exactly what is registered in the provider console.
# When running locally: http://localhost:8000/callback
# When running in Docker behind a proxy: https://yourdomain.com/callback
REDIRECT_URI=http://localhost:8000/callback

# ── MCP Server ────────────────────────────────────────────────────────────────
# Full URL of the MCP Server's SSE endpoint.
# Examples:
#   SSE (classic):         http://localhost:8001/sse
#   Streamable HTTP:       http://localhost:8001/mcp
MCP_SERVER_URL=http://localhost:8001/sse

# Transport layer to use: "sse" (default) | "streamable_http"
# Requires mcp>=1.2 for streamable_http.
MCP_TRANSPORT=sse

# ── App Security ──────────────────────────────────────────────────────────────
# Secret key used to sign session cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-hex-string
